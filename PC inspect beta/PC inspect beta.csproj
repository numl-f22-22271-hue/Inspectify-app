<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net8.0-windows;net8.0</TargetFrameworks>
		<RootNamespace>PC_inspect_beta</RootNamespace>
		<AssemblyName>InspectifyScanner</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>PC-a-icon.ico</ApplicationIcon>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>

		<!-- Single-file publish settings -->
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<!-- Windows-only target: WinForms UI + ML.NET (x64) -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
		<UseWindowsForms>true</UseWindowsForms>
		<OutputType>WinExe</OutputType>
		<DefineConstants>$(DefineConstants);WINDOWS;HAS_ML</DefineConstants>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<!-- Cross-platform target: Mac/Linux Avalonia UI -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<DefineConstants>$(DefineConstants);CROSSPLATFORM</DefineConstants>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<PlatformTarget>AnyCPU</PlatformTarget>
	</PropertyGroup>

	<!-- Shared cross-platform packages -->
	<ItemGroup>
		<PackageReference Include="MongoDB.Driver" Version="2.28.0" />
		<PackageReference Include="MongoDB.Driver.GridFS" Version="2.28.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="itext7" Version="9.5.0" />
		<PackageReference Include="itext7.bouncy-castle-adapter" Version="9.5.0" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.10" />
	</ItemGroup>

	<!-- Windows-only packages (ML.NET requires x64/x86 — won't run on Apple Silicon) -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
		<PackageReference Include="Microsoft.ML" Version="3.0.1" />
		<PackageReference Include="Microsoft.ML.FastTree" Version="3.0.1" />
		<PackageReference Include="Microsoft.VisualBasic" Version="10.3.0" />
		<PackageReference Include="System.Management" Version="10.0.1" />
	</ItemGroup>

	<!-- Cross-platform packages: Avalonia UI -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Avalonia" Version="11.2.0" />
		<PackageReference Include="Avalonia.Desktop" Version="11.2.0" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.0" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.0" />
	</ItemGroup>

	<!-- Exclude Windows-only files when building for Mac/Linux -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<Compile Remove="UI\Forms\**\*.cs" />
		<Compile Remove="UI\Theme.cs" />
		<Compile Remove="UI\UIHelper.cs" />
		<Compile Remove="Core\PricePredictor.cs" />
		<None Remove="UI\Forms\**\*.resx" />
		<EmbeddedResource Remove="UI\Forms\**\*.resx" />
	</ItemGroup>

	<!-- Exclude cross-platform UI files when building for Windows -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
		<Compile Remove="UI\Avalonia\**\*.cs" />
		<AvaloniaResource Remove="UI\Avalonia\**\*.axaml" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Data\laptop_dataset.csv">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
