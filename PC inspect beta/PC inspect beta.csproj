<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>PC_inspect_beta</RootNamespace>
		<AssemblyName>InspectifyScanner</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>PC-a-icon.ico</ApplicationIcon>
		<NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<PlatformTarget>AnyCPU</PlatformTarget>

		<!-- Single-file publish settings -->
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<PublishReadyToRun>true</PublishReadyToRun>
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<!-- Windows-specific defines (WMI + ML.NET available) -->
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) OR $(RuntimeIdentifier.StartsWith('win'))">
		<DefineConstants>$(DefineConstants);WINDOWS;HAS_ML</DefineConstants>
	</PropertyGroup>

	<!-- Shared cross-platform packages -->
	<ItemGroup>
		<PackageReference Include="MongoDB.Driver" Version="2.28.0" />
		<PackageReference Include="MongoDB.Driver.GridFS" Version="2.28.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="itext7" Version="9.5.0" />
		<PackageReference Include="itext7.bouncy-castle-adapter" Version="9.5.0" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.10" />
	</ItemGroup>

	<!-- Avalonia UI packages — used on all platforms -->
	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.2.0" />
		<PackageReference Include="Avalonia.Desktop" Version="11.2.0" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.0" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.0" />
	</ItemGroup>

	<!-- Windows-only packages: WMI + ML.NET (x64 only, won't run on Apple Silicon) -->
	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) OR $(RuntimeIdentifier.StartsWith('win'))">
		<PackageReference Include="Microsoft.ML" Version="3.0.1" />
		<PackageReference Include="Microsoft.ML.FastTree" Version="3.0.1" />
		<PackageReference Include="Microsoft.VisualBasic" Version="10.3.0" />
		<PackageReference Include="System.Management" Version="10.0.1" />
	</ItemGroup>

	<!-- Exclude WinForms UI and the old WinForms-based DiagnosticsEngine -->
	<ItemGroup>
		<Compile Remove="UI\Forms\**\*.cs" />
		<Compile Remove="UI\Theme.cs" />
		<Compile Remove="UI\UIHelper.cs" />
		<Compile Remove="Core\DiagnosticsEngine.cs" />
		<None Remove="UI\Forms\**\*.resx" />
		<EmbeddedResource Remove="UI\Forms\**\*.resx" />
	</ItemGroup>

	<!-- PricePredictor uses ML.NET — only compile when ML is available -->
	<ItemGroup Condition="!($([MSBuild]::IsOSPlatform('Windows')) OR $(RuntimeIdentifier.StartsWith('win')))">
		<Compile Remove="Core\PricePredictor.cs" />
	</ItemGroup>

	<!-- Embed the training dataset inside the binary — no side-by-side file needed -->
	<ItemGroup>
		<EmbeddedResource Include="Data\laptop_dataset.csv">
			<LogicalName>PC_inspect_beta.Data.laptop_dataset.csv</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

</Project>
